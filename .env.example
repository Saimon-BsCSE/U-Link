# U-Link configuration
#
# Copy this file to `.env` in the project root and adjust the values.
# Real environment variables take precedence over this file.
# `.env` must never be committed.

# ------------------------------------------------------------------ Database
ULINK_DB_DRIVER=mysql
ULINK_DB_HOST=127.0.0.1
ULINK_DB_PORT=3306
ULINK_DB_NAME=ulink_db
ULINK_DB_USER=ulink_user
ULINK_DB_PASS=change-me
ULINK_DB_CHARSET=utf8mb4

# ------------------------------------------------------------------- Runtime
# Set to 1 locally to see error messages in API responses.
ULINK_DEBUG=0

# Comma separated list of allowed origins, or * for any.
# Note: a wildcard disables credentialed CORS, so use an explicit origin when
# the frontend is served from a different host.
ULINK_ALLOWED_ORIGINS=*

# Shared secret required by /api/init/setup.php. Empty disables the check,
# which is fine locally but should be set in production.
ULINK_SETUP_TOKEN=

# ------------------------------------------------------------------ Sessions
ULINK_SESSION_NAME=ulink_session
ULINK_SESSION_LIFETIME=604800
ULINK_SESSION_SAMESITE=Lax
# Leave unset to enable the Secure flag automatically when served over HTTPS.
#ULINK_COOKIE_SECURE=1

# Only enable behind a proxy you control, otherwise clients can spoof their IP.
ULINK_TRUST_PROXY=0

# -------------------------------------------------------------------- Limits
ULINK_UPLOAD_MAX_BYTES=5242880

# Message attachments. Pictures are capped at ULINK_UPLOAD_MAX_BYTES; documents
# get their own, larger cap because they are downloaded rather than displayed.
# These must stay at or below PHP's upload_max_filesize and post_max_size, or
# the request is rejected by PHP before the app ever sees it.
ULINK_ATTACHMENT_MAX_BYTES=10485760

ULINK_PAGE_DEFAULT=20
ULINK_PAGE_MAX=50
ULINK_MIN_PASSWORD_LENGTH=8
